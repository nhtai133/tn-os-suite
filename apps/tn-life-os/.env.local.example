# Owner login credentials
# Generate password hash: node scripts/hash-password.mjs yourpassword
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH

# JWT signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# App URL (for Vercel production)
NEXT_PUBLIC_APP_URL=https://tn-life-os.vercel.app
